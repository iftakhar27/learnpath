# Copy to .env (never commit .env). Double underscore = nested config key.
ASPNETCORE_ENVIRONMENT=Development
Branding__ProductName=LearnPath
Jwt__SigningKey=replace-with-at-least-32-random-bytes-openssl-rand-base64-48
Seed__AdminEmail=admin@example.com
Seed__AdminPassword=ChangeMe!2026
Seed__SampleContent=true
# Payments: UseFakeGateway=true for local dev only (refused in Production)
Razorpay__UseFakeGateway=true
Razorpay__KeyId=rzp_test_xxx
Razorpay__KeySecret=dev_key_secret
Razorpay__WebhookSecret=dev_webhook_secret
# OTP: "log" prints codes to the console (refused in Production); implement MSG91 before launch
Otp__Provider=log
# Bunny Stream (optional locally)
Video__LibraryId=
Video__TokenKey=
Storage__CdnBaseUrl=
Storage__SigningKey=
Cors__Origins__0=http://localhost:3000
